{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build PodMon (Make)",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "type": "shell",
            "label": "Clean PodMon",
            "command": "make clean",
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}